{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What the fleet runs on, by build year",
    "subtitle": "Registered passenger vehicles by motive power and year of manufacture",
    "anchor": "start"
  },
  "width": 600,
  "height": 300,
  "data": {
    "url": "data/motive_by_year.csv",
    "format": {"parse": {"year_of_manufacture": "number", "no_vehicles": "number"}}
  },
  "transform": [
    {"filter": "datum.vehicle_type == 'Passenger vehicles'"},
    {"filter": "datum.year_of_manufacture >= 1990 && datum.year_of_manufacture <= 2024"},
    {"calculate": "indexof(['Petrol','Diesel','Dual fuel','Other','Hybrid electric','Battery/Fuel-cell electric'], datum.motive_power)", "as": "band"}
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "year_of_manufacture",
      "type": "quantitative",
      "title": "Year of manufacture",
      "axis": {"format": "d"},
      "scale": {"domain": [1990, 2024], "nice": false}
    },
    "y": {
      "aggregate": "sum",
      "field": "no_vehicles",
      "type": "quantitative",
      "stack": "center",
      "axis": null
    },
    "order": {"field": "band", "type": "quantitative"},
    "color": {
      "field": "motive_power",
      "type": "nominal",
      "title": "Motive power",
      "scale": {
        "domain": ["Petrol", "Diesel", "Dual fuel", "Other", "Hybrid electric", "Battery/Fuel-cell electric"],
        "range": ["#9aa5ad", "#6b7480", "#c2b8a3", "#ddd8cf", "#2ca25f", "#006d2c"]
      }
    },
    "tooltip": [
      {"field": "year_of_manufacture", "type": "quantitative", "title": "Built", "format": "d"},
      {"field": "motive_power", "type": "nominal", "title": "Motive power"},
      {"aggregate": "sum", "field": "no_vehicles", "type": "quantitative", "title": "Vehicles", "format": ","}
    ]
  }
}