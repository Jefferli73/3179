{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "100 toys vs 100 real cars",
    "subtitle": "One square is one in a hundred, coloured by the decade of the car",
    "anchor": "start"
  },
  "data": {"url": "data/decade_waffle.csv"},
  "mark": {"type": "square", "size": 150, "stroke": "#ffffff", "strokeWidth": 1},
  "width": 200,
  "height": 200,
  "encoding": {
    "column": {"field": "side", "type": "nominal", "title": null, "sort": ["Shelf", "Road"]},
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null, "sort": "descending"},
    "color": {
      "field": "decade",
      "type": "ordinal",
      "title": "Decade of the car",
      "scale": {"scheme": "viridis"}
    },
    "tooltip": [
      {"field": "side", "type": "nominal"},
      {"field": "decade", "type": "ordinal"}
    ]
  }
}